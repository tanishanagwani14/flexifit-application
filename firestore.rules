rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile documents in 'users' collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Appointment bookings in 'appointments' collection
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }
  }
}
